# ==============================================
# Anaid Grupo — Environment Variables
# ==============================================

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/anaidgrupo?schema=public"

# JWT
JWT_SECRET="your-jwt-secret-change-this-in-production"

# Backend
PORT=3001
NODE_ENV=development

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_SITE_URL=https://www.anaidgrupo.com

# SMTP — Hostinger Mail
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=redes@anaidgrupo.com
SMTP_PASS=your-smtp-password
MAIL_FROM=redes@anaidgrupo.com
MAIL_ADMIN=admin@anaidgrupo.com

# n8n (optional)
# N8N_WEBHOOK_URL=http://localhost:5678/webhook

# File uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760
