generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// Enums
// ============================================================

enum Urgencia {
  BAJA
  MEDIA
  ALTA
  URGENTE
}

enum TipoServicio {
  REFORMA_INTEGRAL
  REFORMA_BANO
  REFORMA_COCINA
  ELECTRICIDAD
  FONTANERIA
  CLIMATIZACION
  ARQUITECTO
  PEQUENAS_OBRAS
  NO_SE
}

enum FuenteLead {
  FORMULARIO
  WHATSAPP
  TELEFONO
  CHAT
}

enum EstadoLead {
  NUEVO
  ANALIZADO
  ASIGNADO
  EN_CURSO
  CERRADO
  DESCARTADO
}

enum EstadoProfesional {
  PENDIENTE
  ACTIVO
  PAUSADO
  RECHAZADO
}

enum EstadoAsignacion {
  PENDIENTE
  ACEPTADO
  RECHAZADO
  COMPLETADO
}

enum RolUsuario {
  ADMIN
  PROFESSIONAL
}

enum TipoArchivo {
  FOTO_PROYECTO
  DOCUMENTO_PROFESIONAL
  OTRO
}

// ============================================================
// Models
// ============================================================

model Lead {
  id               String        @id @default(uuid())
  nombre           String
  telefono         String
  email            String
  codigoPostal     String
  descripcion      String
  urgencia         Urgencia      @default(MEDIA)
  tipoServicio     TipoServicio
  noSabeQueNecesita Boolean      @default(false)
  fuente           FuenteLead    @default(FORMULARIO)
  score            Float?
  estado           EstadoLead    @default(NUEVO)
  notas            String?

  fotos            Archivo[]     @relation("LeadFotos")
  asignaciones     Asignacion[]
  chatSession      ChatSession?

  creadoEn         DateTime      @default(now())
  actualizadoEn    DateTime      @updatedAt

  @@index([estado])
  @@index([tipoServicio])
  @@index([urgencia])
  @@index([creadoEn])
}

model Profesional {
  id              String              @id @default(uuid())
  nombre          String
  empresa         String?
  email           String              @unique
  telefono        String
  bio             String?
  rating          Float?
  estado          EstadoProfesional   @default(PENDIENTE)

  especialidades  ProfesionalEspecialidad[]
  zonas           ProfesionalZona[]
  documentos      Archivo[]           @relation("ProfesionalDocumentos")
  asignaciones    Asignacion[]
  usuario         Usuario?

  creadoEn        DateTime            @default(now())
  actualizadoEn   DateTime            @updatedAt

  @@index([estado])
}

model Usuario {
  id              String       @id @default(uuid())
  email           String       @unique
  passwordHash    String
  rol             RolUsuario   @default(PROFESSIONAL)

  profesionalId   String?      @unique
  profesional     Profesional? @relation(fields: [profesionalId], references: [id])

  actividadLogs   ActividadLog[]

  creadoEn        DateTime     @default(now())
  actualizadoEn   DateTime     @updatedAt
}

model Asignacion {
  id               String            @id @default(uuid())
  estado           EstadoAsignacion  @default(PENDIENTE)
  notasProfesional String?
  notasAdmin       String?

  leadId           String
  lead             Lead              @relation(fields: [leadId], references: [id])

  profesionalId    String
  profesional      Profesional       @relation(fields: [profesionalId], references: [id])

  creadoEn         DateTime          @default(now())
  actualizadoEn    DateTime          @updatedAt

  @@index([leadId])
  @@index([profesionalId])
  @@index([estado])
}

model Especialidad {
  id           String    @id @default(uuid())
  nombre       String    @unique
  slug         String    @unique
  descripcion  String?
  activa       Boolean   @default(true)

  profesionales ProfesionalEspecialidad[]
}

model ProfesionalEspecialidad {
  profesionalId  String
  profesional    Profesional   @relation(fields: [profesionalId], references: [id])
  especialidadId String
  especialidad   Especialidad  @relation(fields: [especialidadId], references: [id])

  @@id([profesionalId, especialidadId])
}

model Zona {
  id          String    @id @default(uuid())
  nombre      String    @unique
  slug        String    @unique
  provincia   String    @default("Madrid")
  activa      Boolean   @default(true)

  profesionales ProfesionalZona[]
}

model ProfesionalZona {
  profesionalId String
  profesional   Profesional @relation(fields: [profesionalId], references: [id])
  zonaId        String
  zona          Zona        @relation(fields: [zonaId], references: [id])

  @@id([profesionalId, zonaId])
}

model Archivo {
  id              String       @id @default(uuid())
  url             String
  nombreOriginal  String
  tipo            TipoArchivo  @default(FOTO_PROYECTO)
  mimeType        String
  tamano          Int

  leadId          String?
  lead            Lead?        @relation("LeadFotos", fields: [leadId], references: [id])

  profesionalId   String?
  profesional     Profesional? @relation("ProfesionalDocumentos", fields: [profesionalId], references: [id])

  creadoEn        DateTime     @default(now())

  @@index([leadId])
  @@index([profesionalId])
}

model ChatSession {
  id            String        @id @default(uuid())
  sessionToken  String        @unique @default(uuid())
  resumen       String?
  completado    Boolean       @default(false)

  leadId        String?       @unique
  lead          Lead?         @relation(fields: [leadId], references: [id])

  mensajes      ChatMensaje[]

  creadoEn      DateTime      @default(now())
}

model ChatMensaje {
  id             String       @id @default(uuid())
  rol            String       // "USER" | "BOT"
  contenido      String
  paso           Int?

  chatSessionId  String
  chatSession    ChatSession  @relation(fields: [chatSessionId], references: [id])

  creadoEn       DateTime     @default(now())

  @@index([chatSessionId])
}

model ActividadLog {
  id          String   @id @default(uuid())
  accion      String
  entidad     String
  entidadId   String?
  detalles    Json?

  usuarioId   String?
  usuario     Usuario? @relation(fields: [usuarioId], references: [id])

  creadoEn    DateTime @default(now())

  @@index([entidad, entidadId])
  @@index([creadoEn])
}
